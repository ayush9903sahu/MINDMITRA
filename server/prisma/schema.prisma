// BrainCare Prisma schema
// Module 2 (Authentication) owns the User model.
// Module 3 (Profile) owns the Profile model below.
// Other models are declared as placeholders per the project-wide
// data contract so that future modules (Games, Progress, Reminders)
// can extend them without renaming or duplicating. Do NOT rename fields here
// without updating shared/types and documenting the change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Owned by Module 2 (Authentication)
// ------------------------------------------------------------------
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations to models owned by other modules.
  profile      Profile?
  gameSessions GameSession[]
  reminder     Reminder?

  @@map("users")
}

// ------------------------------------------------------------------
// Owned by Module 3 (Profile)
// ------------------------------------------------------------------
enum Gender {
  FEMALE
  MALE
  NON_BINARY
  PREFER_NOT_TO_SAY
  OTHER
}

model Profile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName     String
  dateOfBirth  DateTime
  gender       Gender   @default(PREFER_NOT_TO_SAY)
  genderCustom String?
  contactEmail String

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?

  // Avatar is stored on disk (server/uploads/avatars/<userId>.<ext>), not in
  // the DB. Only bookkeeping fields live here; the file is served through an
  // authenticated route (see profile.controller.ts), never a public /static
  // path, so avatar images stay behind the same privacy boundary as the rest
  // of the profile.
  avatarPath      String?
  avatarMimeType  String?
  avatarUpdatedAt DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("profiles")
}

// ------------------------------------------------------------------
// Placeholder models owned by FUTURE modules.
// Do not implement business logic for these outside their own module.
// Field names must match the project-wide data contract.
// ------------------------------------------------------------------

model Game {
  id           String        @id @default(uuid())
  name         String
  description  String
  category     String
  difficulty   String
  gameSessions GameSession[]

  @@map("games")
}

model GameSession {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId      String
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  difficulty  String
  score       Int
  duration    Int
  accuracy    Float?
  completedAt DateTime @default(now())

  @@map("game_sessions")
}

model Reminder {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled         Boolean   @default(false)
  intervalHours   Int       @default(24)
  preferredTime   String?
  lastTriggeredAt DateTime?

  @@map("reminders")
}