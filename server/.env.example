# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/braincare?schema=public"

# Secret used to sign JWTs. Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"

# JWT expiry (jsonwebtoken "expiresIn" format)
JWT_EXPIRES_IN="7d"

# Port the Express server listens on
PORT=4000

# Comma-separated list of allowed CORS origins (the client's dev/prod URL)
CLIENT_ORIGIN="http://localhost:5173"

# "development" or "production" — controls cookie "secure" flag, etc.
NODE_ENV="development"
